{
    "name": "hugo-blog-loveit-theme",
    "version": "1.0.0",
    "description": "安卓人的个人技术周记，基于 Hugo 与 LoveIt 构建，由 OpenCode + Step 5 Preview 生成周报，托管于 Cloudflare Pages。",
    "packageManager": "pnpm@11.22.0",
    "scripts": {
        "lint": "eslint themes/LoveIt/src/js scripts e2e playwright.config.ts",
        "build:scripts": "tsc -p tsconfig.scripts.json",
        "typecheck:theme": "tsc --project themes/LoveIt/tsconfig.json --noEmit",
        "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
        "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
        "typecheck": "pnpm run typecheck:theme && pnpm run typecheck:scripts && pnpm run typecheck:e2e",
        "format": "prettier --write \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"config/**/*.json\" \"*.{js,json,jsonc}\" \".github/**/*.yml\"",
        "format:check": "prettier --check \"scripts/**/*.ts\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"config/**/*.json\" \"*.{js,json,jsonc}\" \".github/**/*.yml\"",
        "test": "pnpm run build:scripts && node --test dist/verify-content.test.js dist/collect-github-activity.test.js dist/generate-weekly-report.test.js dist/nvidia-key-pool.test.js",
        "verify:content": "pnpm run build:scripts && node dist/verify-content.js",
        "verify:build": "pnpm run build:scripts && node dist/verify-build.js",
        "audit": "pnpm audit --prod --audit-level high --registry=https://registry.npmjs.org",
        "smoke": "pnpm run build:scripts && node dist/smoke.js",
        "env:check": "pnpm run build:scripts && node dist/check-env.js",
        "collect:activity": "pnpm run build:scripts && node dist/collect-github-activity.js",
        "report:weekly": "pnpm run build:scripts && node dist/generate-weekly-report.js",
        "serve:public": "pnpm run build:scripts && node dist/serve-public.js",
        "e2e": "playwright test",
        "e2e:install": "playwright install chromium",
        "build:theme": "babel themes/LoveIt/src/js --out-file themes/LoveIt/assets/js/theme.js --extensions \".ts\" --presets @babel/preset-env,@babel/preset-typescript",
        "build": "pnpm run build:theme && hugo --gc --minify",
        "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run verify:content",
        "check:full": "pnpm run check && pnpm run build && pnpm run verify:build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/3y3y3y-huaiji/hugo-blog-loveit-theme.git"
    },
    "keywords": [
        "hugo",
        "blog",
        "loveit",
        "weekly-report",
        "github-actions",
        "opencode",
        "glm",
        "cloudflare-pages"
    ],
    "author": "安卓人",
    "license": "MIT",
    "type": "commonjs",
    "devDependencies": {
        "@babel/cli": "^8.1.0",
        "@babel/core": "^8.1.0",
        "@babel/preset-env": "^8.0.7",
        "@babel/preset-typescript": "^8.0.7",
        "@playwright/test": "^1.65.0",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "eslint": "^10.14.0",
        "prettier": "^3.10.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.2"
    },
    "dependencies": {
        "dotenv": "^18.0.10"
    }
}
