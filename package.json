{
    "name": "hugo-blog-loveit-theme",
    "version": "1.0.0",
    "description": "安卓人的个人技术周记，基于 Hugo 与 LoveIt 构建，由 OpenCode + GLM 5.3 Flash 生成周报，托管于 Cloudflare Pages。",
    "packageManager": "pnpm@11.22.0",
    "scripts": {
        "lint": "eslint themes/LoveIt/src/js scripts",
        "typecheck": "tsc --project themes/LoveIt/tsconfig.json --noEmit",
        "format": "prettier --write \"scripts/**/*.mjs\" \"config/**/*.json\" \"*.{js,json,jsonc}\" \".github/**/*.yml\"",
        "format:check": "prettier --check \"scripts/**/*.mjs\" \"config/**/*.json\" \"*.{js,json,jsonc}\" \".github/**/*.yml\"",
        "test": "node --test scripts/verify-content.test.mjs scripts/collect-github-activity.test.mjs scripts/generate-weekly-report.test.mjs",
        "verify:content": "node scripts/verify-content.mjs",
        "verify:build": "node scripts/verify-build.mjs",
        "audit": "pnpm audit --prod --audit-level high --registry=https://registry.npmjs.org",
        "smoke": "node scripts/smoke.mjs",
        "env:check": "node scripts/check-env.mjs",
        "collect:activity": "node scripts/collect-github-activity.mjs",
        "report:weekly": "node scripts/generate-weekly-report.mjs",
        "build:theme": "babel themes/LoveIt/src/js --out-file themes/LoveIt/assets/js/theme.js --extensions \".ts\" --presets @babel/preset-env,@babel/preset-typescript",
        "build": "pnpm run build:theme && hugo --gc --minify",
        "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run verify:content",
        "check:full": "pnpm run check && pnpm run build && pnpm run verify:build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/3y3y3y-huaiji/hugo-blog-loveit-theme.git"
    },
    "keywords": [
        "hugo",
        "blog",
        "loveit",
        "weekly-report",
        "github-actions",
        "opencode",
        "glm",
        "cloudflare-pages"
    ],
    "author": "安卓人",
    "license": "MIT",
    "type": "commonjs",
    "devDependencies": {
        "@babel/cli": "^8.1.0",
        "@babel/core": "^8.1.0",
        "@babel/preset-env": "^8.0.7",
        "@babel/preset-typescript": "^8.0.7",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "eslint": "^10.14.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.2"
    },
    "dependencies": {
        "dotenv": "^18.0.10"
    }
}
