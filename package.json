{
  "name": "hugo-blog-loveit-theme",
  "version": "1.0.0",
  "description": "基于 Hugo 静态站点生成器与 LoveIt 主题构建的全自动 AI 科技博客，由 GLM 5.2（NVIDIA NIM）单一模型撰写博文并自动部署至 Cloudflare Workers。",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "lint": "eslint scripts",
    "typecheck": "tsc --noEmit && tsc --project themes/LoveIt/tsconfig.json --noEmit",
    "build:theme": "babel themes/LoveIt/src/js --out-file themes/LoveIt/assets/js/theme.js --extensions \".ts\" --presets @babel/preset-env,@babel/preset-typescript",
    "generate:ai-post": "ts-node scripts/generate-ai-post.ts",
    "build:cloudflare": "pnpm run build:theme && hugo --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3y3y3y-huaiji/hugo-blog-loveit-theme.git"
  },
  "keywords": ["hugo", "blog", "loveit", "ai", "automation", "nvidia-nim"],
  "author": "3y3y3y-huaiji",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/3y3y3y-huaiji/hugo-blog-loveit-theme/issues"
  },
  "homepage": "https://github.com/3y3y3y-huaiji/hugo-blog-loveit-theme#readme",
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "rss-parser": "^3.13.0"
  }
}
